#!/bin/bash
set -e

{{ if eq .chezmoi.os "darwin" -}}
# Source brew into PATH — scripts don't inherit shell environment
eval "$(/opt/homebrew/bin/brew shellenv)"

# CLI tools
brew install \
  git \
  gh \
  ghq \
  fzf \
  starship \
  bat \
  eza \
  git-delta \
  chezmoi \
  atuin \
  uv \
  pnpm \
  node \
  jq \
  zoxide \
  herdr \
  colima \
  docker \
  docker-compose

# Start the Colima VM now and at login so docker works without `colima start`
brew services start colima

# Apps
brew install --cask obsidian spotify
{{ else if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "cachyos") (contains "arch" (.chezmoi.osRelease.idLike | default ""))) -}}
# CLI tools
sudo pacman -S --needed --noconfirm \
  git \
  github-cli \
  ghq \
  fzf \
  starship \
  bat \
  eza \
  git-delta \
  chezmoi \
  atuin \
  uv \
  pnpm \
  nodejs \
  jq \
  npm \
  zoxide \
  zsh \
  zip \
  unzip \
  base-devel \
  paru \
  tailscale \
  docker \
  docker-compose \
  docker-buildx \
  obsidian \
  spotify-launcher \
  mangohud \
  nvtop \
  power-profiles-daemon

# AUR packages
paru -S --needed --noconfirm \
  nordvpn-bin \
  visual-studio-code-bin \
  shellcheck-bin \
  herdr-bin

# VPN daemons
sudo systemctl enable --now tailscaled nordvpnd
sudo usermod -aG nordvpn "$USER"

# Docker daemon; docker group allows running docker without sudo
sudo systemctl enable --now docker
sudo usermod -aG docker "$USER"

# Performance power profile for gaming; power-profiles-daemon persists it across reboots
sudo systemctl enable --now power-profiles-daemon
powerprofilesctl set performance

# VS Code extensions
extensions=(
  vscodevim.vim
  usernamehw.errorlens
  editorconfig.editorconfig
  jdinhlife.gruvbox
  timonwong.shellcheck
  tamasfe.even-better-toml
  mtxr.sqltools
)
for ext in "${extensions[@]}"; do
  code --install-extension "$ext" --force
done
{{ else -}}
echo "unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}
