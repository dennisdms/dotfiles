#!/bin/sh
# Merges Homebrew's CLI plugin dir into ~/.docker/config.json so `docker compose` works.
set -eu

managed='{
  "cliPluginsExtraDirs": ["/opt/homebrew/lib/docker/cli-plugins"]
}'

current=$(cat)
[ -n "$current" ] || current='{}'

printf '%s\n' "$current" | jq --argjson managed "$managed" '. * $managed'
