# SSH Agent
if [ -z "$SSH_AUTH_SOCK" ] && [ -x "$(command -v ssh-agent)" ]; then
    eval "$(ssh-agent -s)" >/dev/null
    ssh-add -q
fi

# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Claude
export PATH="$HOME/.local/bin:$PATH"

# Homebrew
[ -f /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# fzf
eval "$(fzf --zsh)"

# atuin
eval "$(atuin init zsh)"

# source local .zshrc
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# cargo
export PATH="$HOME/.cargo/bin:$PATH"

# zoxide
eval "$(zoxide init zsh)"

# word deletion and navigation
WORDCHARS=${WORDCHARS//[\/.=-]}

bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

# aliases
alias ls='eza -la --git'
alias lt='eza --tree --level=3'
alias j='z'
alias jj='zi'
command -v ghostty >/dev/null && alias ssh='ghostty +ssh --'

# scratch <name>: cd into a new timestamped ~/scratch dir
scratch() {
    if [ $# -ne 1 ]; then
        echo "usage: scratch <name>" >&2
        return 1
    fi
    local dir="$HOME/scratch/$(date +%Y-%m-%d_%H%M%S)-$1"
    mkdir -p "$dir" && cd "$dir"
}

# Starship
eval "$(starship init zsh)"
