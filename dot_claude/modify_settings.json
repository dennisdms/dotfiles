#!/bin/sh
# Deep-merges the managed keys into ~/.claude/settings.json, keeping keys Claude Code writes.
set -eu

managed='{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash ~/.claude/herdr-session-title.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash ~/.claude/herdr-session-title.sh" }] }
    ]
  }
}'

current=$(cat)
[ -n "$current" ] || current='{}'

# Union hook lists so hooks other tools register survive.
printf '%s\n' "$current" | jq --argjson managed "$managed" '
  (.hooks // {}) as $hooks
  | . * ($managed | del(.hooks))
  | .hooks = reduce ($managed.hooks | to_entries[]) as $e ($hooks;
      .[$e.key] = ((.[$e.key] // []) as $have
        | $have + [$e.value[] | select(. as $x | any($have[]; . == $x) | not)]))
'
