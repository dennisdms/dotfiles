#!/bin/sh
# chezmoi modify_ script for ~/.claude/settings.json.
# Receives the current file on stdin and deep-merges the managed keys below
# into it, so settings Claude Code writes itself (/config, plugins,
# permissions) are kept. Managed keys win on conflict.
set -eu

managed='{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash ~/.claude/herdr-session-title.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash ~/.claude/herdr-session-title.sh" }] }
    ]
  }
}'

current=$(cat)
[ -n "$current" ] || current='{}'

# jq's `*` replaces arrays, which would drop hooks other tools register
# (e.g. herdr's session hook), so hook lists are unioned per event instead.
printf '%s\n' "$current" | jq --argjson managed "$managed" '
  (.hooks // {}) as $hooks
  | . * ($managed | del(.hooks))
  | .hooks = reduce ($managed.hooks | to_entries[]) as $e ($hooks;
      .[$e.key] = ((.[$e.key] // []) as $have
        | $have + [$e.value[] | select(. as $x | any($have[]; . == $x) | not)]))
'
