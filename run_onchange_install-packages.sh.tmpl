#!/bin/bash
set -e

{{ if eq .chezmoi.os "darwin" -}}
# Source brew into PATH — scripts don't inherit shell environment
eval "$(/opt/homebrew/bin/brew shellenv)"

# CLI tools
brew install \
  git \
  gh \
  ghq \
  fzf \
  starship \
  bat \
  eza \
  git-delta \
  chezmoi \
  atuin \
  uv \
  pnpm \
  node \
  zoxide

# Apps
brew install --cask obsidian spotify
{{ else if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "cachyos") (contains "arch" (.chezmoi.osRelease.idLike | default ""))) -}}
# CLI tools
sudo pacman -S --needed --noconfirm \
  git \
  github-cli \
  ghq \
  fzf \
  starship \
  bat \
  eza \
  git-delta \
  chezmoi \
  atuin \
  uv \
  pnpm \
  nodejs \
  npm \
  zoxide \
  zsh \
  zip \
  unzip \
  base-devel \
  paru \
  tailscale \
  obsidian \
  spotify-launcher

# AUR packages
paru -S --needed --noconfirm \
  nordvpn-bin \
  visual-studio-code-bin \
  shellcheck-bin

# VPN daemons
sudo systemctl enable --now tailscaled nordvpnd
sudo usermod -aG nordvpn "$USER"

# VS Code extensions
extensions=(
  vscodevim.vim
  usernamehw.errorlens
  editorconfig.editorconfig
  enkia.tokyo-night
  timonwong.shellcheck
  tamasfe.even-better-toml
  mtxr.sqltools
)
for ext in "${extensions[@]}"; do
  code --install-extension "$ext" --force
done
{{ else -}}
echo "unsupported OS: {{ .chezmoi.os }}" >&2
exit 1
{{ end -}}
