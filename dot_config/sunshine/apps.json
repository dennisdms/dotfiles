{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png",
      "prep-cmd": [
        {
          "do": "kscreen-doctor output.DP-1.mirror.DP-2",
          "undo": "kscreen-doctor output.DP-1.mirror.none"
        },
        {
          "do": "kscreen-doctor output.DP-2.scale.1.5",
          "undo": "kscreen-doctor output.DP-2.scale.1"
        }
      ]
    },
    {
      "name": "Steam Big Picture",
      "detached": [
        "setsid steam steam://open/bigpicture"
      ],
      "prep-cmd": [
        {
          "do": "",
          "undo": "setsid steam steam://close/bigpicture"
        }
      ],
      "image-path": "steam.png"
    }
  ]
}
